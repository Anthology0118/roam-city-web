APP_NAME="RoamCity AI API"
# 默认使用本地 SQLite 零配置启动；生产/PgVector 可切换为：
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/roamcity
DATABASE_URL=sqlite+aiosqlite:///./roamcity.db

# 可选：配置任意兼容 OpenAI 协议的大模型（DeepSeek / 通义千问 / OpenAI）
# 不填时自动启用确定性本地 Fallback 模式，完整演示 SSE 与 Tool Calling 流程
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
